rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== USER CV SUBMISSIONS =====
    // Users can upload to their own folder
    match /cv_submissions/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats.*|octet-stream)');
    }

    // ===== ADMIN REFINED CVs =====
    // Only admins can write here; the submission owner can read
    match /cv_refined/{submissionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024;
    }

    // ===== ANNOTATION IMAGES =====
    match /cv_refined/{submissionId}_annotation/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ADMIN REGISTRY =====
    // Admins read their own doc to confirm access. Write only via Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ===== SUBSCRIPTIONS =====
    match /subscriptions/{docUid} {
      // Any authenticated user can read their own subscription
      allow read: if request.auth != null && request.auth.uid == docUid;

      // Users can CREATE their own pending request only — no self-granting active status
      allow create: if request.auth != null
        && request.auth.uid == docUid
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == docUid
        && request.resource.data.wasJustActivated == false
        && request.resource.data.flagged == false;

      // Users can UPDATE only to resubmit — allowed when current status is pending or expired
      // They cannot change any admin-controlled fields
      allow update: if request.auth != null
        && request.auth.uid == docUid
        && (resource.data.status == 'pending' || resource.data.status == 'expired' || resource.data.status == 'active')
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.wasJustActivated == resource.data.wasJustActivated
        && request.resource.data.flagged == resource.data.flagged;

      // Users can write limited fields on their own active doc:
      // - exportCount / exportCountDate (daily cap tracking)
      // - status = 'expired' (auto-expire when expiresAt passes)
      // - wasJustActivated = false (clearing the notification flag)
      allow update: if request.auth != null
        && request.auth.uid == docUid
        && resource.data.status == 'active'
        && (
          // Auto-expire: client sets status to 'expired'
          (request.resource.data.status == 'expired'
            && request.resource.data.expiresAt == resource.data.expiresAt)
          ||
          // Export counter update (recordExport)
          (request.resource.data.status == 'active'
            && request.resource.data.expiresAt == resource.data.expiresAt
            && request.resource.data.wasJustActivated == false)
        );

      // Admins can read and write all subscription documents
      // Admin check: the user has their own document in the admins collection
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===== USER CVs =====
    match /cvs/{cvId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // ===== CV REVIEW SUBMISSIONS =====
    match /cv_submissions/{subId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read, update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===== REVIEW FEEDBACK =====
    match /cv_reviews/{reviewId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===== MESSAGES =====
    match /cv_messages/{msgId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.uid == resource.data.adminId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

  }
}
